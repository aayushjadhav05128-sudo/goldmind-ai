{
  "name": "goldmind-ai-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "GoldMind AI — Advanced XAUUSD Quantitative Intelligence & Calibrated Prediction System",
  "scripts": {
    "setup": "bash .devcontainer/setup.sh",
    "dev": "bash .devcontainer/start.sh",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --port 8001 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "pytest backend/tests -v",
    "train": "python backend/scripts/train_model.py",
    "backtest": "python backend/scripts/run_backtest.py"
  }
}
