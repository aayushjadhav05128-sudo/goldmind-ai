# ==========================================
# GOLDMIND AI — CONFIGURATION TEMPLATE
# ==========================================

# 1. TradingView Integration Secret
# Set this to a secure random string and configure the same secret in the Pine Script indicator
TV_WEBHOOK_SECRET=gm_secret_production_2026

# 2. AI Explanation Provider (Optional)
# Options: "gemini", "openai", "deterministic" (offline fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Capital Protection Defaults
DEFAULT_ACCOUNT_CURRENCY=INR
DEFAULT_ACCOUNT_BALANCE=2000.0
DEFAULT_RISK_PER_TRADE_PCT=0.5
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0

# 4. Market & Instrument Specifications (XAUUSD Gold)
USD_INR_RATE=86.50
XAUUSD_CONTRACT_SIZE=100.0
BROKER_MIN_LOT=0.01
BROKER_LOT_STEP=0.01
DEFAULT_LEVERAGE=100.0

# 5. Database
DATABASE_URL=sqlite+aiosqlite:///./goldmind.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/goldmind_db
